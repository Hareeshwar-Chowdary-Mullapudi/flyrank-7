# Copy to .env and fill in real values. Never commit .env.

# Provider (OpenRouter free lane — flip privacy switches first)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free

# Or Ollama local lane:
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_API_KEY=ollama
# LLM_MODEL=gemma3:1b

# Kill switch / stub (Stage 1+)
LLM_ENABLED=true
LLM_STUB=1

PORT=3000
